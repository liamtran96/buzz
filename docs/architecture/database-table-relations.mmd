        GitRepos[(git_repo_names)]
        Feedback[(product_feedback)]
        Heartbeat[(replica_heartbeat - single row)]
    end

    PushGateway["push_gateway_* tables<br/>(6 tables, non-tenant-scoped,<br/>own migration set in buzz-push-gateway)"]

